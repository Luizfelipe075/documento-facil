# ============================================================
# Documento Fácil — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do arquivo .env.
# ============================================================

# --- LLM ---
# Provedor de LLM: gemini | openai
LLM_PROVIDER=gemini

# Chave da API do Gemini. No Netlify, configure como variável GEMINI_API_KEY
# no painel do site (não use a chave no código do navegador nem no GitHub).
GEMINI_API_KEY=
# Compatibilidade com o pipeline Python antigo:
GOOGLE_API_KEY=

# Chave da API da OpenAI (alternativa)
OPENAI_API_KEY=

# Modelo Gemini.
# ATENÇÃO: os modelos gemini-1.5-* foram descontinuados pelo Google e retornam 404.
# 'gemini-flash-latest' é um alias para o Flash mais recente. Se sua chave não
# aceitar, liste os modelos disponíveis em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-flash-latest

# Modelo OpenAI (alternativa)
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# Modelo de embeddings (local, Hugging Face)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Recuperação ---
RETRIEVAL_K=5

# --- Coleta ---
# Pausa entre requisições (segundos)
RATE_LIMIT_SECONDS=1.5

# Número máximo de documentos a coletar por execução
COLLECT_LIMIT=50
